# Backend LLM & Database Configuration
GEMINI_API_KEY=
XAI_API_KEY=
LLM_PROVIDER=gemini
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lexlens
FRONTEND_URL=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
