# ==============================================================================
# LexLens — Root Environment Configuration Template
# Copy this file to backend/.env (and frontend/.env if customizing frontend URL)
# ==============================================================================

# Backend LLM & Database Configuration
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_api_key_here
LLM_PROVIDER=gemini
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lexlens

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
